  "axioms_status": {
    "status": "IMMUTABLE_AXIOMATIC_CORE",
    "description": "Непорушний аксиоматичний ядро системи, що фіксує fundamentálne принципи дій ШІ та інформаційної політики"
  },
  "relational_keys": {
    "region_code": {
      "type": "integer",
      "description": "Integer key linking to regions_register.json and OSINT passports (e.g., 63, 77, 8)"
    },
    "contour": {
      "type": "string",
      "enum": ["Tanunah", "Achtung", "universal"],
      "description": "Contour affiliation from chancery_manifest.json worker_nodes"
    },
    "knowledge_id": {
      "type": "string",
      "description": "Unique identifier for knowledge entry (format: K-XXX)"
    },
    "status": {
      "type": "string",
      "enum": ["active", "archived", "pending"],
      "description": "Status of the knowledge entry in the flat context knowledge base"
    }
  },
  "metropole_boundary_policy": {
    "read_only_fact": true,
    "ukraine_zone": "read_only",
    "post_rf_zone": "allowed",
    "belarus_zone": "allowed",
    "metropole_signal_processing": {
      "constructive_mode": "AMPLIFY_IN_PHASE",
