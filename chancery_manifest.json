  "osint_passport_schema": {
    "type": "object",
    "required": [
      "region_code",
      "original_name",
      "imperial_title",
      "assigned_ataman",
      "contour",
      "coordinates",
      "osint_profile"
    ],
    "properties": {
      "region_code": {
        "type": "integer"
      },
      "original_name": {
        "type": "string"
      },
      "imperial_title": {
        "type": "string"
      },
      "assigned_ataman": {
        "type": "string"
      },
      "contour": {
        "type": "string",
        "enum": [
          "Tanunah",
          "Achtung",
          "universal"
        ]
      },
      "coordinates": {
        "type": "object",
        "required": [
          "lat",
          "lng"
        ],
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "map_layer_id": {
            "type": "string"
          }
        }
      },
      "osint_profile": {
        "type": "object",
        "required": [
          "infrastructure_status",
          "smotryaschy_nickname",
          "social_tension",
          "operational_signals"
        ],
        "properties": {
          "infrastructure_status": {
            "type": "string"
          },
          "smotryaschy_nickname": {
            "type": "string"
          },
          "social_tension": {
            "type": "string"
          },
          "operational_signals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "fact_appropriation_schema": {
      "type": "object",
      "required": ["fact_id", "real_event_source", "timestamp", "target_region_code", "decree_number", "issuing_ataman", "appropriated_narrative", "contour"],
      "properties": {
        "fact_id": { "type": "string" },
        "real_event_source": { "type": "string" },
        "timestamp": { "type": "number" },
        "target_region_code": { "type": "integer" },
        "decree_number": { "type": "string" },
        "issuing_ataman": { "type": "string" },
        "appropriated_narrative": { "type": "string" },
        "contour": { "type": "string", "enum": ["Tanunah", "Achtung"] }
      }
    }
  },
  "schema_registries": {
    "core_entities": "src/data/core/entities_core.json",
    "chancery_directives": "src/data/modules/chancery_directives.json",
